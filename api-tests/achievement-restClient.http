### Get health of the service
GET http://localhost:8080/api/cmd/achievement/health HTTP/1.1
accept: */*
X-API-Version: 1

### Create a new Achievement

@authToken = eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJwZWRyb2YiLCJ1c2VyS2V5IjoidHdXcnlXTSIsImVtYWlsIjoicGVkcm9mQGV4YW1wbGUuY29tIiwiZmlyc3ROYW1lIjoiVGhyb2siLCJsYXN0TmFtZSI6IkJvbmUiLCJpYXQiOjE3NTkwNDIzNDIsImV4cCI6MTc1OTEyODc0Mn0.M9FhOw2Jg0QGX1g-M-4aheEW_2tq8kL9L_pSxV8mq8Eiez6vGzy9p2bmA_jpG834

POST http://localhost:8080/api/cmd/achievement HTTP/1.1
Content-Type: application/json
accept: application/json
X-API-Version: 1
Authorization: Bearer {{authToken}}

{
  "title": "Master of HTTP Testing",
  "description": "Testing HTTP endpoints with precision and expertise.",
  "completedDate": "2024-12-01",
  "skills": ["int", "cha", "luc"],
  "isPublic": true
}

### Get achievement details by entityKey

GET http://localhost:8080/api/qry/achievement/detail?size=lg&entityKey=G0x0SmZ HTTP/1.1
Content-Type: application/json
accept: application/json
X-API-Version: 1
Authorization: Bearer {{authToken}}

### Add a Comment to the Achievement
POST http://localhost:8080/api/cmd/achievement/8NctRKY/comments HTTP/1.1
Content-Type: application/json
accept: application/json
X-API-Version: 1
Authorization: Bearer {{authToken}}

{
"commentText": "Best achievmeent I've ever achieved"
}

### Update an existing Achievement
PUT http://localhost:8080/api/cmd/achievement/G0x0SmZ HTTP/1.1
Content-Type: application/json
accept: application/json
X-API-Version: 1
Authorization: Bearer {{authToken}}

{
  "title": "A new updated title",
  "description": "A new updated description",
  "skills": ["str", "dex", "int"],
  "isPublic": false
}

### Disable an existing Achievement
PATCH http://localhost:8080/api/cmd/achievement/PFBB8UQ/disable HTTP/1.1
Content-Type: application/json
accept: application/json
X-API-Version: 1
Authorization: Bearer {{authToken}}

### Delete an existing Achievement
DELETE http://localhost:8080/api/cmd/achievement/PFBB8UQ HTTP/1.1
Content-Type: application/json
accept: application/json
X-API-Version: 1
Authorization: Bearer {{authToken}}


### Add a Celebration to the Achievement
POST http://localhost:8080/api/cmd/achievement/oYIuT8w/celebration HTTP/1.1
Content-Type: application/json
accept: application/json
X-API-Version: 1
Authorization: Bearer {{authToken}}

{
  "count":9
}