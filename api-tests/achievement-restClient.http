### Get health of the service
GET http://localhost:8080/api/cmd/achievement/health HTTP/1.1
accept: */*
X-API-Version: 1

### Create a new Achievement

@authToken = eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJwZWRyb2YiLCJ1c2VyS2V5IjoiOGhTV2VNaSIsImVtYWlsIjoicGVkcm9mQGV4YW1wbGUuY29tIiwiZmlyc3ROYW1lIjoiT2xnYSIsImxhc3ROYW1lIjoiTW91bnRhaW5oYXJ0IiwiaWF0IjoxNzU4MTM4MTUyLCJleHAiOjE3NTgyMjQ1NTJ9.-B6IoRDUWNiB7np8nz4nostZ6hEr8HDTDVvrUKPyPfGoK7THB2fE1Dj5keGBz0K2

POST http://localhost:8080/api/cmd/achievement HTTP/1.1
Content-Type: application/json
accept: application/json
X-API-Version: 1
Authorization: Bearer {{authToken}}

{
  "userKey": "8hSWeMi",
