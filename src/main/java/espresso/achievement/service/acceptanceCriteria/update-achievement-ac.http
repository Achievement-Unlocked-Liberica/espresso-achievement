### Variables for Update Achievement Tests
@baseUrl = http://localhost:8080
@jwtToken = YOUR_JWT_TOKEN_HERE
@validUserKey = ABC1234
@invalidUserKey = XYZ9999
@validAchievementKey = 8NctRKY
@invalidAchievementKey = INVALID
@otherUserAchievementKey = OTHER123

### AC1: Successful Achievement Update
# Tests: Valid JWT token, user owns achievement, valid update data
# Expected: HTTP 200 OK with entity key response
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Multi File Upload System",
  "description": "Successfully implemented and enhanced multi file upload for achievement media with validation.",
  "skills": ["int", "wis", "con"],
  "isPublic": false
}

### AC2.1: Missing JWT Token
# Tests: Authentication failure - no JWT token provided
# Expected: HTTP 401 Unauthorized
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Update",
  "description": "This request should fail due to missing JWT token",
  "skills": ["str"]
}

### AC2.2: Invalid or Expired JWT Token
# Tests: Authentication failure - invalid JWT token
# Expected: HTTP 401 Unauthorized
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer INVALID_TOKEN_HERE
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Update",
  "description": "This request should fail due to invalid JWT token",
  "skills": ["str"]
}

### AC3: User Not Found
# Tests: Valid JWT but user doesn't exist in system
# Expected: HTTP 404 Not Found with correlation ID
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Update",
  "description": "Valid update data but user from JWT doesn't exist",
  "skills": ["int"]
}

### AC4: Achievement Not Found
# Tests: Valid user but achievement doesn't exist
# Expected: HTTP 404 Not Found with correlation ID
PUT {{baseUrl}}/api/cmd/achievement/{{invalidAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Update",
  "description": "Valid update data but achievement doesn't exist",
  "skills": ["int"]
}

### AC5: Unauthorized Access (Not Owner)
# Tests: User doesn't own the achievement being updated
# Expected: HTTP 401 Unauthorized with correlation ID
PUT {{baseUrl}}/api/cmd/achievement/{{otherUserAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Unauthorized Update",
  "description": "Attempting to update achievement owned by another user",
  "skills": ["int"]
}

### AC6.1: Missing Required Fields - Title
# Tests: JSR-303 validation failure - missing title
# Expected: HTTP 400 Bad Request with validation error
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "description": "Missing title field in update",
  "skills": ["int"]
}

### AC6.2: Field Length Validation - Title Too Long
# Tests: JSR-303 validation failure - title exceeds 200 characters
# Expected: HTTP 400 Bad Request with length validation error
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "This is a very long title that exceeds the maximum allowed length of 200 characters and should trigger a validation error because it contains way too many characters and goes beyond the specified limit making it invalid for the system to process properly",
  "description": "Valid description",
  "skills": ["int"]
}

### AC7.1: Invalid Skills
# Tests: Custom validation failure - skills not in allowed list
# Expected: HTTP 400 Bad Request with skill validation error
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Achievement",
  "description": "Updated description",
  "skills": ["magic", "invalid", "str"]
}

### AC7.2: Too Many/Few Skills - Empty Array
# Tests: JSR-303 validation failure - empty skills array
# Expected: HTTP 400 Bad Request with skills required error
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Achievement",
  "description": "Updated description",
  "skills": []
}

### AC7.2: Too Many Skills
# Tests: JSR-303 validation failure - more than 7 skills
# Expected: HTTP 400 Bad Request with skills count validation error
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Achievement",
  "description": "Updated description",
  "skills": ["str", "dex", "con", "wis", "int", "cha", "luc", "extra"]
}

### AC - Successful Update with All Skills
# Tests: Update with all allowed skills
# Expected: HTTP 200 OK with entity key response
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "All Skills Updated Achievement",
  "description": "Updated achievement testing all allowed skills: str, dex, con, wis, int, cha, luc",
  "skills": ["str", "dex", "con", "wis", "int", "cha", "luc"],
  "isPublic": true
}

### AC - Update with Case Sensitivity and Whitespace
# Tests: Skills normalization during update
# Expected: HTTP 200 OK with entity key response
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Case and Whitespace Test Update",
  "description": "Testing skill normalization during update",
  "skills": [" STR ", "  dex", "INT  "],
  "isPublic": false
}

### AC - Minimal Update Request
# Tests: Minimum required fields for successful update
# Expected: HTTP 200 OK with entity key response
PUT {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Minimal Update",
  "description": "This is the minimal valid update with required fields only",
  "skills": ["str"]
}