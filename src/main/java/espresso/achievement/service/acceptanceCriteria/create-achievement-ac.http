}

### AC6.1: Invalid Skills
# Tests: Custom validation failure - skills not in allowed list
# Expected: HTTP 400 Bad Request with skill validation error
POST {{baseUrl}}/api/cmd/achievement
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Achievement",
  "description": "Test description",
  "completedDate": "2025-01-15",
  "skills": ["magic", "invalid", "str"]
}

### AC6.2: Too Many Skills
# Tests: JSR-303 validation failure - more than 7 skills
# Expected: HTTP 400 Bad Request with skills count validation error
POST {{baseUrl}}/api/cmd/achievement
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Achievement",
  "description": "Test description", 
  "completedDate": "2025-01-15",
  "skills": ["str", "dex", "con", "wis", "int", "cha", "luc", "extra"]
}

### AC6.3: No Skills Provided
# Tests: JSR-303 validation failure - empty skills array
# Expected: HTTP 400 Bad Request with skills required error
POST {{baseUrl}}/api/cmd/achievement
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Achievement",
  "description": "Test description",
  "completedDate": "2025-01-15", 
  "skills": []
}

### AC7.1: Explicit Public Setting
# Tests: Achievement visibility - explicitly set to public
# Expected: HTTP 201 Created with entity key response
POST {{baseUrl}}/api/cmd/achievement
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Public Achievement",
  "description": "This achievement is public",
  "completedDate": "2025-01-15",
  "skills": ["str"],
  "isPublic": true
}

### AC7.2: Explicit Private Setting
# Tests: Achievement visibility - explicitly set to private
# Expected: HTTP 201 Created with entity key response
POST {{baseUrl}}/api/cmd/achievement
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Private Achievement", 
  "description": "This achievement is private",
  "completedDate": "2025-01-15",
  "skills": ["wis"],
  "isPublic": false
}

### AC7.3: Default Visibility (isPublic not specified)
# Tests: Achievement visibility - default behavior when isPublic omitted
# Expected: HTTP 201 Created with entity key response (defaults to public)
POST {{baseUrl}}/api/cmd/achievement
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Default Achievement",
  "description": "This achievement uses default visibility",
  "completedDate": "2025-01-15", 
  "skills": ["int"]
}

### AC9.1: Skills Case Sensitivity
