### Variables for Upload Achievement Media Tests
@baseUrl = http://localhost:8080
@jwtToken = YOUR_JWT_TOKEN_HERE
@validUserKey = ABC1234
@invalidUserKey = XYZ9999
@validAchievementKey = 8NctRKY
@nonExistentAchievementKey = MISSING
@otherUserAchievementKey = OTHER123

### AC1: Successful Media Upload (Single Image)
# Tests: Valid JWT token, user owns achievement, valid image file
# Expected: HTTP 200 OK with entity key response
# Note: Replace [binary image data] with actual image file in multipart request
POST {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundary123

--boundary123
Content-Disposition: form-data; name="images"; filename="achievement_screenshot.png"
Content-Type: image/png

[Upload a PNG image file here]
--boundary123--

### AC1: Successful Media Upload (Multiple Images)
# Tests: Valid JWT token, user owns achievement, multiple valid image files
# Expected: HTTP 200 OK with entity key response
POST {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundary456

--boundary456
Content-Disposition: form-data; name="images"; filename="screenshot1.png"
Content-Type: image/png

[Upload first PNG image file here]
--boundary456
Content-Disposition: form-data; name="images"; filename="progress_chart.jpg"
Content-Type: image/jpeg

[Upload JPEG image file here]
--boundary456--

### AC2.1: Missing JWT Token
# Tests: Authentication failure - no JWT token provided
# Expected: HTTP 401 Unauthorized
POST {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}/media
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundary789

--boundary789
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundary789--

### AC2.2: Invalid or Expired JWT Token
# Tests: Authentication failure - invalid JWT token
# Expected: HTTP 401 Unauthorized
POST {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}/media
Authorization: Bearer INVALID_TOKEN_HERE
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryInvalid

--boundaryInvalid
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundaryInvalid--

### AC3: User Not Found
# Tests: Valid JWT but user doesn't exist in system
# Expected: HTTP 404 Not Found with correlation ID
POST {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryUser

--boundaryUser
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundaryUser--

### AC4: Achievement Not Found
# Tests: Valid user but achievement doesn't exist
# Expected: HTTP 404 Not Found with correlation ID
POST {{baseUrl}}/api/cmd/achievement/{{nonExistentAchievementKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryAch

--boundaryAch
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundaryAch--

### AC5: Unauthorized Access (Not Owner)
# Tests: User doesn't own the achievement
# Expected: HTTP 401 Unauthorized with correlation ID
POST {{baseUrl}}/api/cmd/achievement/{{otherUserAchievementKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryUnauth

--boundaryUnauth
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundaryUnauth--

### AC6.1: Empty Image Upload
# Tests: No image files provided
# Expected: HTTP 400 Bad Request - ACHIEVEMENT MEDIA CANNOT BE EMPTY
POST {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryEmpty

--boundaryEmpty--

### AC6.3: Invalid Content Type
# Tests: Non-image file upload (text file)
# Expected: HTTP 400 Bad Request - invalid content type
POST {{baseUrl}}/api/cmd/achievement/{{validAchievementKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryText

--boundaryText
Content-Disposition: form-data; name="images"; filename="document.txt"
Content-Type: text/plain

This is a text file, not an image
--boundaryText--

