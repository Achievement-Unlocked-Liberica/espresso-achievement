### AC1: Successful Challenge Creation
# Tests: Valid JWT token, existing user, valid challenge data
# Expected: HTTP 201 Created with entity key response
POST {{baseUrl}}/api/cmd/challenge
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Complete Advanced Spring Security Course",
  "description": "Successfully complete the advanced Spring Security course and implement all security patterns.",
  "fulfillmentDate": "2025-12-31",
  "skills": ["int", "wis", "luc"],
  "isPublic": true
}

### AC2.1: Missing JWT Token
# Tests: Authentication failure - no JWT token provided
# Expected: HTTP 401 Unauthorized
POST {{baseUrl}}/api/cmd/challenge
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Challenge",
  "description": "This request should fail due to missing JWT token",
  "fulfillmentDate": "2025-12-31",
  "skills": ["str"]
}

### AC2.2: Invalid JWT Token
# Tests: Authentication failure - invalid JWT token
# Expected: HTTP 401 Unauthorized
POST {{baseUrl}}/api/cmd/challenge
Authorization: Bearer INVALID_TOKEN_HERE
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Challenge",
  "description": "This request should fail due to invalid JWT token",
  "fulfillmentDate": "2025-12-31",
  "skills": ["str"]
}

### AC3: User Not Found
# Tests: Valid JWT but user doesn't exist in system
# Expected: HTTP 404 Not Found with correlation ID
POST {{baseUrl}}/api/cmd/challenge
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Test Challenge",
  "description": "Valid challenge data but user from JWT doesn't exist",
  "fulfillmentDate": "2025-12-31",
  "skills": ["int"]
}

### AC4.1: Missing Required Fields - Title
# Tests: JSR-303 validation failure - missing title
# Expected: HTTP 400 Bad Request with validation error
POST {{baseUrl}}/api/cmd/challenge
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "description": "Missing title field",
  "fulfillmentDate": "2025-12-31",
  "skills": ["int"]
}

### AC4.2: Empty Required Fields
# Tests: JSR-303 validation failure - empty title and description
# Expected: HTTP 400 Bad Request with validation errors
POST {{baseUrl}}/api/cmd/challenge
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "",
  "description": "   ",
  "fulfillmentDate": "2025-12-31",
  "skills": ["int"]
}

### AC4.3: Field Length Validation - Title Too Long
# Tests: JSR-303 validation failure - title exceeds 200 characters
# Expected: HTTP 400 Bad Request with length validation error
POST {{baseUrl}}/api/cmd/challenge
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "This is a very long title that exceeds the maximum allowed length of 200 characters and should trigger a validation error because it contains way too many characters and goes beyond the specified limit making it invalid for the system to process properly",
  "description": "Valid description",
  "fulfillmentDate": "2025-12-31",
  "skills": ["int"]
}

### AC4.3: Field Length Validation - Description Too Long
# Tests: JSR-303 validation failure - description exceeds 1000 characters
# Expected: HTTP 400 Bad Request with length validation error
POST {{baseUrl}}/api/cmd/challenge
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Valid Title",
  "description": "This is an extremely long description that exceeds the maximum allowed length of 1000 characters for challenge descriptions. It contains way too many words and characters, going far beyond what should be acceptable for a description field. The purpose is to test the validation system and ensure it properly rejects descriptions that are too lengthy. This description continues to add more and more text to ensure we definitely exceed the 1000 character limit imposed by the system validation rules. We need to make sure this triggers the appropriate validation error message and returns the correct HTTP status code. This description is intentionally verbose and repetitive to guarantee we surpass the character limit and test the field length validation functionality of the challenge creation endpoint. The system should reject this request and return a proper validation error message indicating that the description field exceeds the maximum allowed length of 1000 characters.",
  "fulfillmentDate": "2025-12-31",
  "skills": ["int"]
}

