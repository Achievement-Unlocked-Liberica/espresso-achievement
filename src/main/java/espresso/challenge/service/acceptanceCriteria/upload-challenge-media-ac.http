### AC6.6: Invalid Filename Characters
# Tests: Filename with special characters not allowed
# Expected: HTTP 400 Bad Request - "INVALID FILENAME"
POST {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryInvalidName

--boundaryInvalidName
Content-Disposition: form-data; name="images"; filename="image@#$%.png"
Content-Type: image/png

[Upload PNG image with invalid filename characters]
--boundaryInvalidName--

### AC7: Multiple File Processing (3 Images)
# Tests: Upload multiple valid images in single request
# Expected: HTTP 200 OK with all images processed and saved
POST {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryMulti

--boundaryMulti
Content-Disposition: form-data; name="images"; filename="image1.png"
Content-Type: image/png

[Upload first PNG image]
--boundaryMulti
Content-Disposition: form-data; name="images"; filename="image2.jpg"
Content-Type: image/jpeg

[Upload second JPEG image]
--boundaryMulti
Content-Disposition: form-data; name="images"; filename="image3.gif"
Content-Type: image/gif

[Upload third GIF image]
--boundaryMulti--

### AC7: Multiple File Processing (Mixed Valid/Invalid)
# Tests: Mix of valid and invalid files (should reject entire request)
# Expected: HTTP 400 Bad Request for first validation failure
POST {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryMixed

--boundaryMixed
Content-Disposition: form-data; name="images"; filename="valid_image.png"
Content-Type: image/png

[Upload valid PNG image]
--boundaryMixed
Content-Disposition: form-data; name="images"; filename="invalid.txt"
Content-Type: text/plain

[Upload invalid text file]
--boundaryMixed--

