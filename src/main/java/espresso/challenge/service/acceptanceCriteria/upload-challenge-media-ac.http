### AC2.1: Missing JWT Token
# Tests: Authentication failure - no JWT token provided
# Expected: HTTP 401 Unauthorized
POST {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}/media
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundary789

--boundary789
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundary789--

### AC2.2: Invalid or Expired JWT Token
# Tests: Authentication failure - invalid JWT token
# Expected: HTTP 401 Unauthorized
POST {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}/media
Authorization: Bearer INVALID_TOKEN_HERE
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryInvalid

--boundaryInvalid
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundaryInvalid--

### AC3: User Not Found
# Tests: Valid JWT but user doesn't exist in system
# Expected: HTTP 404 Not Found with correlation ID
POST {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryUser

--boundaryUser
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundaryUser--

### AC4: Challenge Not Found
# Tests: Valid user but challenge doesn't exist
# Expected: HTTP 404 Not Found with correlation ID
POST {{baseUrl}}/api/cmd/challenge/{{nonExistentChallengeKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryChallenge

--boundaryChallenge
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundaryChallenge--

### AC5: Unauthorized Access (Not Owner)
# Tests: Valid user tries to upload media to another user's challenge
# Expected: HTTP 401 Unauthorized with correlation ID
POST {{baseUrl}}/api/cmd/challenge/{{otherUserChallengeKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryUnauth

--boundaryUnauth
Content-Disposition: form-data; name="images"; filename="test.png"
Content-Type: image/png

[Upload PNG image file here]
--boundaryUnauth--

### AC6.1: Empty Image Upload
# Tests: No image files provided in request
# Expected: HTTP 400 Bad Request - "CHALLENGE MEDIA CANNOT BE EMPTY"
POST {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryEmpty

--boundaryEmpty--

### AC6.2: File Size Validation (>10MB)
# Tests: Image file exceeds maximum size limit
# Expected: HTTP 400 Bad Request - "CHALLENGE MEDIA EXCEEDS MAXIMUM SIZE OF 10MB"
# Note: Upload an image file larger than 10MB
POST {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}/media
Authorization: Bearer {{jwtToken}}
X-API-Version: 1.0
Content-Type: multipart/form-data; boundary=boundaryLarge

--boundaryLarge
Content-Disposition: form-data; name="images"; filename="huge_image.png"
Content-Type: image/png

[Upload an image file > 10MB here]
--boundaryLarge--

