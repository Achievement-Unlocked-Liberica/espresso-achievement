  "skills": ["str", "dex"]
}

### AC6.5 - Empty Skills Array
# Tests: JSR-303 validation failure - empty skills array
# Expected: HTTP 400 Bad Request with "LOCALIZE: AT LEAST ONE SKILL MUST BE PROVIDED"
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "description": "Testing empty skills validation",
  "skills": []
}

### AC6.6 - Too Many Skills
# Tests: JSR-303 validation failure - more than 7 skills
# Expected: HTTP 400 Bad Request with skills count validation error
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "description": "Testing too many skills validation",
  "skills": ["str", "dex", "con", "wis", "int", "cha", "luc", "extra"]
}

### AC7.1 - Invalid Skill Value
# Tests: Custom validation failure - invalid skill
# Expected: HTTP 400 Bad Request with "skills[0]: LOCALIZE: INVALID SKILL 'magic'. ALLOWED SKILLS ARE: str, dex, con, wis, int, cha, luc"
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "description": "Testing invalid skill validation",
  "skills": ["magic", "str"]
}

### AC7.1 - Multiple Invalid Skills
# Tests: Custom validation failure - multiple invalid skills
# Expected: HTTP 400 Bad Request with multiple skill validation errors
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "description": "Testing multiple invalid skills",
  "skills": ["magic", "wizardry", "str"]
}

### AC - Successful Update with All Skills
# Tests: Update with all allowed skills
# Expected: HTTP 200 OK with entity key response
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "All Skills Updated Challenge",
  "description": "Updated challenge testing all allowed skills: str, dex, con, wis, int, cha, luc",
  "skills": ["str", "dex", "con", "wis", "int", "cha", "luc"],
  "isPublic": true
}

### AC - Update with Case Sensitivity and Whitespace
# Tests: Skills normalization during update
# Expected: HTTP 200 OK with entity key response
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Case and Whitespace Test Update",
  "description": "Testing skill normalization during update",
  "skills": [" STR ", "  dex", "INT  "],
  "isPublic": false
}

