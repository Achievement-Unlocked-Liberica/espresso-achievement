@baseUrl = http://localhost:8080
@jwtToken = eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJBQkNEMTIzIiwiaWF0IjoxNzM3NzI4NDI0LCJleHAiOjE3Mzc4MTQ4MjR9.XxYzAbc123
@validChallengeKey = 8NctRKY
@invalidChallengeKey = INVALID
@otherUserToken = eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJYWVpVOTk5IiwiaWF0IjoxNzM3NzI4NDI0LCJleHAiOjE3Mzc4MTQ4MjR9.DifferentToken

### AC1 - Successful Challenge Update
# Tests: Successfully update a challenge with valid data
# Expected: HTTP 200 OK with entity key response
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Enhanced Multi File Upload System Challenge",
  "description": "Successfully implement and optimize multi file upload for challenge media with advanced validation and error handling.",
  "skills": ["int", "wis", "con", "dex"],
  "isPublic": false
}

### AC2.1 - Missing JWT Token
# Tests: Update challenge without authentication
# Expected: HTTP 401 Unauthorized
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "description": "This should fail due to missing authentication",
  "skills": ["str", "dex"]
}

### AC2.2 - Invalid JWT Token
# Tests: Update challenge with invalid JWT token
# Expected: HTTP 401 Unauthorized
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer invalid.jwt.token
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "description": "This should fail due to invalid token",
  "skills": ["str", "dex"]
}

### AC3 - User Not Found
# Tests: Update challenge when user does not exist
# Expected: HTTP 404 Not Found with "User not found" error
# Note: Use a JWT token with non-existent userKey for testing
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "description": "Testing user not found scenario",
  "skills": ["str", "dex"]
}

### AC4 - Challenge Not Found
# Tests: Update non-existent challenge
# Expected: HTTP 404 Not Found with "LOCALIZE: CHALLENGE NOT FOUND" error
PUT {{baseUrl}}/api/cmd/challenge/{{invalidChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "description": "Testing challenge not found scenario",
  "skills": ["str", "dex"]
}

### AC5 - Unauthorized Access (Not Challenge Owner)
# Tests: Update challenge owned by different user
# Expected: HTTP 401 Unauthorized with "LOCALIZE: USER IS NOT AUTHORIZED TO UPDATE THIS CHALLENGE"
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{otherUserToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Unauthorized Update Attempt",
  "description": "This should fail because user is not the challenge owner",
  "skills": ["str", "dex"]
}

### AC6.1 - Missing Title
# Tests: JSR-303 validation failure - missing title
# Expected: HTTP 400 Bad Request with "LOCALIZE: A TITLE MUST BE PROVIDED"
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "description": "Testing missing title validation",
  "skills": ["str", "dex"]
}

### AC6.2 - Title Too Long
# Tests: JSR-303 validation failure - title exceeds 200 characters
# Expected: HTTP 400 Bad Request with title length validation error
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "This is an extremely long title that exceeds the maximum allowed length of 200 characters and will be rejected by validation because it violates the @Size constraint annotation defined on the title field in UpdateChallengeCommand class which enforces maximum 200 character limit for challenge titles",
  "description": "Valid description",
  "skills": ["str", "dex"]
}

### AC6.3 - Missing Description
# Tests: JSR-303 validation failure - missing description
# Expected: HTTP 400 Bad Request with "LOCALIZE: A DESCRIPTION MUST BE PROVIDED"
PUT {{baseUrl}}/api/cmd/challenge/{{validChallengeKey}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
X-API-Version: 1.0

{
  "title": "Updated Challenge",
  "skills": ["str", "dex"]
}

